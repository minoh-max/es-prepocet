# Lokálne spustenie: hodnoty nastavte v termináli (napr. export DATABASE_URL=...).
# DATABASE_URL – pripojenie k PostgreSQL; hodnota "memory" = skúšobná databáza v pamäti (po reštarte prázdna)
DATABASE_URL=memory
# ANTHROPIC_API_KEY – čítanie štúdií cez AI; bez neho funguje všetko okrem rozpoznania podkladov
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MODEL_QUICK=claude-haiku-5-5
# Prvý administrátor – vytvorí sa len vtedy, keď v databáze ešte nie je žiadny používateľ
ADMIN_EMAIL=admin@ekonomicke-stavby.sk
ADMIN_PASSWORD=zmente-ma-123
# AI_MOCK=1 – testovacie odpovede AI bez kľúča
